{
  "name": "roaia-business-solutions",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "build": "vite build && vite build --config vite.client.config.ts",
    "build:server": "vite build",
    "build:client": "vite build --config vite.client.config.ts",
    "preview": "wrangler pages dev dist",
    "pages:deploy": "wrangler pages deploy dist",
    "pages:deploy:prod": "wrangler pages deploy dist --project-name roaia-business-solutions",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.555.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250105.0",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^3.78.0"
  }
}
